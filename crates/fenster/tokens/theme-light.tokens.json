{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.papier.100}"
      },
      "panel": {
        "$value": "{color.papier.50}"
      },
      "raised": {
        "$value": "{color.papier.200}"
      },
      "input": {
        "$value": "{color.papier.0}"
      },
      "hover": {
        "$value": "{color.papier.250}"
      },
      "selected": {
        "$value": "{color.papier.300}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.papier.300}"
      },
      "strong": {
        "$value": "{color.papier.400}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.papier.900}"
      },
      "muted": {
        "$value": "{color.papier.700}"
      },
      "faint": {
        "$value": "{color.papier.600}"
      },
      "on-accent": {
        "$value": "{color.papier.50}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.bernstein.700}"
      },
      "hover": {
        "$value": "{color.bernstein.900}"
      },
      "pressed": {
        "$value": "{color.bernstein.500}"
      },
      "deep": {
        "$value": "{color.bernstein.500}"
      }
    },
    "status": {
      "ok": {
        "$value": "{color.gruen.700}"
      },
      "warn": {
        "$value": "{color.ocker}"
      },
      "error": {
        "$value": "{color.rot.700}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.bernstein.700}"
      }
    }
  }
}