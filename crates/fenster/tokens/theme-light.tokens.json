{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.tinte.50}"
      },
      "panel": {
        "$value": "{color.tinte.200}"
      },
      "raised": {
        "$value": "{color.tinte.100}"
      },
      "input": {
        "$value": "{color.weiss.0}"
      },
      "hover": {
        "$value": "{color.tinte.300}"
      },
      "selected": {
        "$value": "{color.tinte.400}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.tinte.400}"
      },
      "strong": {
        "$value": "{color.tinte.700}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.tinte.900}"
      },
      "muted": {
        "$value": "{color.tinte.700}"
      },
      "faint": {
        "$value": "{color.tinte.600}"
      },
      "on-accent": {
        "$value": "{color.weiss.0}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.tinte.900}"
      },
      "hover": {
        "$value": "{color.tinte.800}"
      },
      "pressed": {
        "$value": "{color.tinte.1000}"
      },
      "deep": {
        "$value": "{color.tinte.400}"
      }
    },
    "signal": {
      "default": {
        "$value": "{color.bernstein.700}"
      },
      "hover": {
        "$value": "{color.bernstein.900}"
      },
      "deep": {
        "$value": "{color.bernstein.400}"
      }
    },
    "status": {
      "ok": {
        "$value": "{color.gruen.700}"
      },
      "warn": {
        "$value": "{color.ocker.700}"
      },
      "error": {
        "$value": "{color.rot.700}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.tinte.900}"
      }
    }
  }
}
